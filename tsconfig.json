{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],

    "paths": {
      "@/*": ["./src/*"]
    },

    "module": "node16",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Recommended Options
    "strict": true,
    "skipLibCheck": true,

    // "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true
    // "moduleDetection": "force"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
